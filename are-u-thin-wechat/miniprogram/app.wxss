page {
  min-height: 100%;
  background:
    radial-gradient(circle at 86% 8%, rgba(255, 255, 255, 0.7) 0, rgba(255, 255, 255, 0.7) 110rpx, transparent 111rpx),
    radial-gradient(circle at 12% 18%, rgba(250, 114, 93, 0.16) 0, rgba(250, 114, 93, 0.16) 90rpx, transparent 91rpx),
    radial-gradient(circle at 85% 88%, rgba(105, 184, 163, 0.15) 0, rgba(105, 184, 163, 0.15) 120rpx, transparent 121rpx),
    linear-gradient(135deg, #fff4eb 0%, #f6f9ff 100%);
  color: #28282e;
  font-family: "Avenir Next", "PingFang SC", sans-serif;
}

view,
text,
button,
input,
textarea,
label,
switch,
image,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: inherit;
  border: none;
  border-radius: 0;
}

button::after {
  border: none;
}

.screen {
  min-height: 100vh;
  padding: 36rpx 32rpx 214rpx;
}

.screen-tight {
  min-height: 100vh;
  padding: 44rpx 32rpx 72rpx;
}

.hero-title {
  display: block;
  font-size: 56rpx;
  line-height: 1.16;
  font-weight: 700;
  letter-spacing: 0.6rpx;
  color: #25262c;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #6f7480;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.soft-card {
  width: 100%;
  padding: 32rpx 30rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 42rpx rgba(31, 35, 41, 0.07);
}

.section-title {
  font-size: 32rpx;
  line-height: 1.34;
  font-weight: 600;
  color: #25262c;
}

.body-text {
  font-size: 27rpx;
  line-height: 1.68;
  color: #666c78;
}

.helper-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #98a0ad;
}

.status-text {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #69b8a3;
}

.error-text {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #e96b5b;
}

.mono-text {
  font-size: 24rpx;
  line-height: 1.45;
  color: #737988;
  font-family: "Menlo", "SFMono-Regular", monospace;
}

.primary-button {
  width: 100%;
  padding: 26rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #fc8a68 0%, #ffb46f 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
  text-align: center;
  box-shadow: 0 18rpx 34rpx rgba(252, 138, 104, 0.24);
}

.primary-button.disabled {
  opacity: 0.45;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  color: #515864;
}

.gradient-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fc8a68 0%, #ffb46f 100%);
  color: #ffffff;
}

.progress-track {
  width: 100%;
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(116, 120, 132, 0.1);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.page-gap {
  display: flex;
  flex-direction: column;
}

.page-gap > view,
.page-gap > scroll-view,
.page-gap > button {
  margin-top: 28rpx;
}

.page-gap > view:first-child,
.page-gap > scroll-view:first-child,
.page-gap > button:first-child {
  margin-top: 0;
}
