.coach-screen {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 36rpx 32rpx 198rpx;
}

.coach-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.coach-header-copy {
  padding-top: 4rpx;
  padding-right: 20rpx;
}

.agent-status {
  display: inline-flex;
  align-self: flex-start;
  margin-bottom: 16rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.agent-status-connected {
  background: rgba(105, 184, 163, 0.16);
  color: #2e8e79;
}

.agent-status-fallback {
  background: rgba(250, 114, 93, 0.14);
  color: #d45e4d;
}

.coach-emoji {
  flex-shrink: 0;
  margin-top: 6rpx;
  font-size: 54rpx;
  line-height: 1;
}

.message-list {
  flex: 1;
  min-height: 720rpx;
  padding: 8rpx 0 16rpx;
}

.message-row {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 16rpx;
}

.message-row-user {
  justify-content: flex-end;
}

.message-bubble {
  max-width: 80%;
  padding: 22rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 10rpx 24rpx rgba(31, 35, 41, 0.05);
}

.message-bubble-user {
  background: #fa725d;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #25262c;
}

.message-text-user {
  color: #ffffff;
}

.coach-footer {
  margin-top: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(129, 135, 147, 0.12);
}

.prompt-scroll {
  margin-top: 6rpx;
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.prompt-row {
  display: inline-flex;
  padding-right: 20rpx;
}

.prompt-pill {
  margin-right: 12rpx;
}

.coach-error {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #d45e4d;
}

.input-bar {
  display: flex;
  align-items: center;
}

.coach-input {
  flex: 1;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
}

.send-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-left: 16rpx;
  border-radius: 44rpx;
  background: #69b8a3;
  color: #ffffff;
  font-size: 34rpx;
  box-shadow: 0 12rpx 24rpx rgba(105, 184, 163, 0.18);
}

.send-button-disabled {
  opacity: 0.45;
}
