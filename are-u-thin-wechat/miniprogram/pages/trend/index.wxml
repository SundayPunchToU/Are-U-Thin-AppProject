<scroll-view class="trend-scroll" scroll-y="true">
  <view class="screen page-gap" style="padding-top: {{pageTopInset}}px;">
    <view class="header-copy trend-header-copy">
      <text class="hero-title">这一周的节奏</text>
      <text class="hero-subtitle">连续 {{streakDays}} 天有记录，慢慢看清身体反馈。</text>
    </view>

    <view class="soft-card">
      <text class="section-title">本周概览</text>
      <text class="summary-calorie mono-text">周均 {{weeklyAverageCalories}} kcal / 天</text>
      <text class="body-text summary-copy">{{goalSubtitle}}</text>
      <view class="meal-status-wrap">
        <text class="body-text">今天已记录的餐次</text>
        <view class="meal-status-row">
          <view wx:for="{{todayMealTypeStatus}}" wx:key="value" class="meal-status-chip {{item.recorded ? 'meal-status-chip-active' : ''}}">
            {{item.label}}{{item.count ? ' · ' + item.count : ''}}
          </view>
        </view>
      </view>
      <text wx:if="{{loading}}" class="body-text status-text">正在同步最近 7 天数据...</text>
      <text wx:if="{{errorText}}" class="error-text">{{errorText}}</text>
    </view>

    <view class="soft-card">
      <text class="section-title">本周热量趋势</text>
      <view wx:if="{{hasTrendData}}">
        <view class="chart-wrap">
          <view wx:for="{{weeklyTrend}}" wx:key="label" class="chart-item">
            <view class="chart-bar-track">
              <view class="chart-bar" style="height: {{item.barHeight}}rpx; background: {{item.hitTarget ? '#69B8A3' : '#FA725D'}};"></view>
            </view>
            <text class="mono-text chart-label">{{item.label}}</text>
          </view>
        </view>
        <text class="body-text">浅绿色表示更接近建议范围，珊瑚色表示这天吃得更丰盛一点。</text>
      </view>
      <text wx:else class="body-text empty-state">还没有足够的数据形成趋势，先去记录今天的第一餐吧。</text>
    </view>

    <view class="soft-card">
      <text class="section-title">温和提醒</text>
      <text class="body-text summary-copy">{{weeklyInsight}}</text>
      <button class="record-pill" bindtap="goRecord">去记录一餐</button>
    </view>
  </view>
</scroll-view>
