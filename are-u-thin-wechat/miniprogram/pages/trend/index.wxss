.trend-scroll {
  height: 100vh;
}

.trend-header-copy {
  max-width: 88%;
  padding-top: 4rpx;
}

.summary-calorie {
  display: block;
  margin-top: 18rpx;
  font-size: 44rpx;
  color: #28282e;
}

.summary-copy {
  display: block;
  margin-top: 12rpx;
}

.meal-status-wrap {
  margin-top: 18rpx;
}

.meal-status-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.meal-status-chip {
  margin-right: 14rpx;
  margin-bottom: 14rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  color: #8b909b;
}

.meal-status-chip-active {
  background: rgba(250, 114, 93, 0.14);
  color: #fa725d;
  font-weight: 600;
}

.chart-wrap {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 280rpx;
  margin-top: 24rpx;
  margin-bottom: 18rpx;
}

.chart-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.chart-bar-track {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 48rpx;
  height: 196rpx;
}

.chart-bar {
  width: 48rpx;
  border-radius: 16rpx;
}

.chart-label {
  margin-top: 8rpx;
}

.empty-state {
  display: block;
  margin-top: 18rpx;
}

.record-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  margin-top: 20rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: #fa725d;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}
