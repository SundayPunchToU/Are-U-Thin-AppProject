.trend-scroll {
  height: 100vh;
}

.trend-header-copy {
  max-width: 88%;
  padding-top: 4rpx;
}

.card-head {
  display: flex;
  flex-direction: column;
}

.card-caption {
  margin-top: 8rpx;
}

.summary-calorie {
  display: block;
  margin-top: 18rpx;
  font-size: 42rpx;
  color: #25262c;
}

.summary-copy {
  display: block;
  margin-top: 12rpx;
}

.meal-status-wrap {
  margin-top: 18rpx;
  padding: 18rpx 18rpx 4rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.56);
}

.meal-status-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.meal-status-chip {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  color: #8b909b;
}

.meal-status-chip-active {
  background: rgba(250, 114, 93, 0.14);
  color: #fa725d;
  font-weight: 600;
}

.chart-wrap {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 280rpx;
  margin-top: 24rpx;
  margin-bottom: 14rpx;
  padding: 0 6rpx;
}

.chart-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.chart-bar-track {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 48rpx;
  height: 196rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(242, 244, 247, 0.4) 0%, rgba(242, 244, 247, 0.08) 100%);
}

.chart-bar {
  width: 48rpx;
  border-radius: 16rpx;
}

.chart-label {
  margin-top: 10rpx;
}

.chart-note {
  display: block;
}

.empty-state {
  display: block;
  margin-top: 18rpx;
}

.record-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  margin-top: 20rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: #fa725d;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(250, 114, 93, 0.16);
}
