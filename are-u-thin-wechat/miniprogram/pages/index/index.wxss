/* 登录页面 */
.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx 80rpx;
  background: linear-gradient(180deg, #FDF8F6 0%, #FFF5F2 100%);
}

/* 品牌区域 */
.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 120rpx;
  margin-bottom: 64rpx;
}

.brand-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FA725D 0%, #FF9A8B 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 48rpx rgba(250, 114, 93, 0.25);
  margin-bottom: 32rpx;
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
}

.brand-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #28282E;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.brand-tagline {
  font-size: 28rpx;
  color: #747884;
}

/* 登录卡片 */
.login-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #28282E;
  margin-bottom: 40rpx;
  text-align: center;
}

/* 头像选择 */
.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.avatar-button {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F5F5F7;
  border: none;
  padding: 0;
  overflow: hidden;
}

.avatar-button::after {
  border: none;
}

.user-avatar {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 48rpx;
  color: #747884;
  line-height: 1;
}

.placeholder-text {
  font-size: 22rpx;
  color: #747884;
  margin-top: 8rpx;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 昵称输入 */
.input-section {
  margin-bottom: 40rpx;
}

.nickname-input {
  width: 100%;
  height: 96rpx;
  background: #F5F5F7;
  border-radius: 24rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  color: #28282E;
  text-align: center;
}

.nickname-input::placeholder {
  color: #A0A4AE;
}

/* 功能说明 */
.features {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-item {
  display: flex;
  align-items: center;
}

.feature-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FA725D;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.feature-text {
  font-size: 28rpx;
  color: #5A5A66;
}

/* 登录按钮 */
.login-button {
  width: 100%;
  height: 100rpx;
  margin-top: 48rpx;
  background: linear-gradient(135deg, #FA725D 0%, #FF9A8B 100%);
  border-radius: 50rpx;
  border: none;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(250, 114, 93, 0.3);
}

.login-button::after {
  border: none;
}

.login-button.loading {
  opacity: 0.7;
}

/* 错误提示 */
.error-message {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #E53935;
  text-align: center;
  padding: 0 32rpx;
}
