/* 登录页面 */
.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx 96rpx;
  background: linear-gradient(180deg, #fdf8f6 0%, #fff6f2 62%, #fffaf7 100%);
}

/* 品牌区域 */
.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 112rpx;
  margin-bottom: 56rpx;
}

.brand-avatar {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fa725d 0%, #ff9a8b 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: 0 22rpx 46rpx rgba(250, 114, 93, 0.22);
  border: 6rpx solid rgba(255, 255, 255, 0.7);
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 60rpx;
  font-weight: 700;
  color: #fff;
}

.brand-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #25262c;
  margin-bottom: 10rpx;
  letter-spacing: 1.6rpx;
}

.brand-tagline {
  font-size: 26rpx;
  line-height: 1.6;
  color: #6f7480;
}

/* 登录卡片 */
.login-card {
  width: 100%;
  padding: 44rpx 36rpx 36rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.84);
  border-radius: 36rpx;
  box-shadow: 0 18rpx 42rpx rgba(35, 34, 40, 0.06);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #25262c;
  margin-bottom: 32rpx;
  text-align: center;
}

/* 头像选择 */
.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.avatar-button {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #faf7f6 0%, #f4f5f8 100%);
  border: 2rpx solid rgba(250, 114, 93, 0.08);
  padding: 0;
  overflow: hidden;
}

.avatar-button::after {
  border: none;
}

.user-avatar {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 48rpx;
  color: #8d94a1;
  line-height: 1;
}

.placeholder-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8d94a1;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 昵称输入 */
.input-section {
  margin-bottom: 32rpx;
}

.nickname-input {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  background: #f7f7f9;
  border: 2rpx solid transparent;
  font-size: 30rpx;
  color: #25262c;
  text-align: center;
}

.nickname-input::placeholder {
  color: #a0a4ae;
}

/* 功能说明 */
.features {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(248, 249, 251, 0.88);
}

.feature-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #fa725d;
  flex-shrink: 0;
}

.feature-text {
  font-size: 26rpx;
  line-height: 1.5;
  color: #565d69;
}

/* 登录按钮 */
.login-button {
  width: 100%;
  height: 96rpx;
  margin-top: 36rpx;
  background: linear-gradient(135deg, #fa725d 0%, #ff9a8b 100%);
  border-radius: 48rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 38rpx rgba(250, 114, 93, 0.26);
}

.login-button::after {
  border: none;
}

.login-button.loading {
  opacity: 0.7;
}

/* 错误提示 */
.error-message {
  margin-top: 24rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #e53935;
  text-align: center;
}
