.profile-scroll {
  height: 100vh;
}

.profile-header {
  display: flex;
  align-items: flex-start;
}

.profile-avatar {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  margin-top: 4rpx;
  border-radius: 60rpx;
  font-size: 52rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 34rpx rgba(250, 114, 93, 0.2);
}

.profile-avatar-image {
  width: 100%;
  height: 100%;
}

.profile-copy {
  margin-left: 22rpx;
}

.profile-header-copy {
  padding-top: 10rpx;
}

.profile-name {
  display: block;
  margin-bottom: 10rpx;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #25262c;
}

.card-head {
  display: flex;
  flex-direction: column;
}

.card-caption {
  margin-top: 8rpx;
}

.profile-description {
  display: block;
  margin-top: 12rpx;
}

.goal-switcher {
  display: flex;
  margin-top: 18rpx;
}

.goal-chip {
  flex: 1;
  margin-right: 12rpx;
  padding: 18rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  text-align: center;
}

.goal-chip:last-child {
  margin-right: 0;
}

.goal-chip-active {
  background: #fa725d;
  box-shadow: 0 12rpx 24rpx rgba(250, 114, 93, 0.16);
}

.goal-chip-text {
  font-size: 24rpx;
  color: #25262c;
}

.goal-chip-text-active {
  color: #ffffff;
}

.plan-goal {
  display: block;
  margin-top: 18rpx;
  margin-bottom: 10rpx;
  font-size: 46rpx;
  line-height: 1.2;
  color: #25262c;
}

.rhythm-row {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  background: rgba(248, 249, 251, 0.8);
}

.rhythm-stat {
  flex: 1;
}

.rhythm-label {
  display: block;
  font-size: 24rpx;
  color: #818692;
}

.rhythm-value {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #25262c;
}

.shortcut-row {
  display: flex;
  margin-top: 20rpx;
}

.shortcut-pill {
  flex: 1;
  margin-right: 12rpx;
  padding: 20rpx 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.shortcut-pill:last-child {
  margin-right: 0;
}

.shortcut-pill-coral {
  background: #fa725d;
  box-shadow: 0 12rpx 24rpx rgba(250, 114, 93, 0.16);
}

.shortcut-pill-mint {
  background: #69b8a3;
  box-shadow: 0 12rpx 24rpx rgba(105, 184, 163, 0.16);
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(129, 135, 147, 0.12);
}

.setting-row:first-of-type {
  margin-top: 18rpx;
  padding-top: 18rpx;
}

.setting-label {
  font-size: 30rpx;
  color: #25262c;
}
