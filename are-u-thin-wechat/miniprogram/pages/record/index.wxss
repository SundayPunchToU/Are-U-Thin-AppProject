.record-scroll {
  height: 100vh;
}

.upload-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 380rpx;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.94) 0%, rgba(250, 250, 250, 0.68) 100%);
  overflow: hidden;
}

.upload-panel-filled {
  background: #f7f7f7;
}

.upload-image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon {
  margin-bottom: 12rpx;
  font-size: 52rpx;
}

.secondary-pill {
  display: inline-flex;
  width: auto;
  padding: 20rpx 28rpx;
  border-radius: 999rpx;
  background: #69b8a3;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.note-area {
  width: 100%;
  height: 180rpx;
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  font-size: 28rpx;
  line-height: 1.5;
}

.note-placeholder {
  color: #9aa0ab;
}

.tag-scroll {
  width: 100%;
  margin-top: 18rpx;
  white-space: nowrap;
}

.tag-row {
  display: inline-flex;
  padding-right: 20rpx;
}

.tag-pill {
  margin-right: 14rpx;
}

.status-text {
  display: block;
  margin-top: 18rpx;
}

.error-text {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #e25a4b;
}

.analysis-card {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.76);
}

.analysis-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #28282e;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.history-name {
  display: block;
  margin-bottom: 6rpx;
  font-size: 28rpx;
  color: #28282e;
}
