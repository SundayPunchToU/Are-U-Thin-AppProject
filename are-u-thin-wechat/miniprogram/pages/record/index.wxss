.record-scroll {
  height: 100vh;
}

.record-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.record-header .header-copy {
  padding-top: 4rpx;
  padding-right: 20rpx;
}

.record-badge {
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
  margin-top: 8rpx;
  border-radius: 46rpx;
  box-shadow: 0 18rpx 34rpx rgba(250, 114, 93, 0.22);
}

.card-head {
  display: flex;
  flex-direction: column;
}

.card-caption {
  margin-top: 8rpx;
}

.step-card {
  padding-top: 26rpx;
  padding-bottom: 22rpx;
}

.step-row {
  display: flex;
  align-items: center;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: inset 0 0 0 1rpx rgba(129, 135, 147, 0.1);
}

.step-dot-active {
  background: #fa725d;
}

.step-dot-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #747884;
}

.step-dot-active .step-dot-text {
  color: #ffffff;
}

.step-label {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #747884;
}

.step-line {
  flex: 1;
  height: 4rpx;
  margin: 0 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(116, 120, 132, 0.12);
}

.step-line-active {
  background: #fa725d;
}

.upload-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 360rpx;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.94) 0%, rgba(250, 250, 250, 0.74) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  overflow: hidden;
}

.upload-panel-filled {
  background: #f7f7f7;
}

.upload-image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 36rpx;
  text-align: center;
}

.upload-icon {
  margin-bottom: 12rpx;
  font-size: 52rpx;
}

.upload-copy {
  max-width: 84%;
}

.secondary-pill {
  display: inline-flex;
  width: auto;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: #69b8a3;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(105, 184, 163, 0.18);
}

.note-area {
  width: 100%;
  height: 168rpx;
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  line-height: 1.6;
}

.note-placeholder {
  color: #9aa0ab;
}

.tag-scroll {
  width: 100%;
  margin-top: 18rpx;
  white-space: nowrap;
}

.tag-row {
  display: inline-flex;
  padding-right: 20rpx;
}

.tag-pill {
  margin-right: 12rpx;
}

.meal-type-section {
  margin-top: 22rpx;
}

.meal-type-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.meal-type-pill {
  margin-right: 14rpx;
  margin-bottom: 14rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  color: #747884;
}

.meal-type-pill-active {
  background: rgba(250, 114, 93, 0.14);
  color: #fa725d;
  font-weight: 600;
}

.analysis-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(250, 114, 93, 0.08);
}

.analysis-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.analysis-badges {
  margin-top: 8rpx;
}

.analysis-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #25262c;
}

.analysis-score,
.analysis-text,
.analysis-emphasis,
.analysis-macro {
  display: block;
  margin-top: 8rpx;
}

.analysis-emphasis {
  color: #25262c;
}

.confidence-row {
  display: flex;
  align-items: flex-start;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(129, 135, 147, 0.12);
}

.confidence-icon {
  margin-right: 10rpx;
  font-size: 24rpx;
  color: #69b8a3;
}

.confidence-text {
  flex: 1;
}

.analysis-group {
  margin-top: 16rpx;
}

.analysis-group-title {
  display: block;
  margin-bottom: 8rpx;
}

.analysis-list-item,
.analysis-note,
.warning-item {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.58;
}

.warning-item {
  color: #d98328;
}

.meal-type-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(105, 184, 163, 0.14);
  font-size: 22rpx;
  color: #4b8f7d;
}

.meal-type-badge-active {
  background: rgba(250, 114, 93, 0.14);
  color: #fa725d;
}

.save-button {
  width: 100%;
  margin-top: 18rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: #fa725d;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 14rpx 28rpx rgba(250, 114, 93, 0.18);
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-empty {
  display: block;
  margin-top: 16rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(129, 135, 147, 0.12);
}

.history-copy {
  flex: 1;
  padding-right: 20rpx;
}

.history-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.history-name {
  display: block;
  font-size: 28rpx;
  color: #25262c;
}

.history-score {
  color: #666c78;
}

.history-calorie {
  margin-top: 2rpx;
}
