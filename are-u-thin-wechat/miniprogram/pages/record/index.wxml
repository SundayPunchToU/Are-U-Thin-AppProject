<scroll-view class="record-scroll" scroll-y="true">
  <view class="screen page-gap">
    <view class="dashboard-header">
      <view>
        <text class="hero-title">Meal Capture</text>
        <text class="hero-subtitle">拍照 + 语音补充，2 秒得到反馈</text>
      </view>
      <view class="dashboard-badge gradient-avatar">
        <text class="dashboard-badge-text">📷</text>
      </view>
    </view>

    <view class="soft-card">
      <text class="section-title">餐食图片</text>
      <view class="upload-panel {{imagePath ? 'upload-panel-filled' : ''}}" bindtap="chooseImage">
        <image wx:if="{{imagePath}}" class="upload-image" src="{{imagePath}}" mode="aspectFill"></image>
        <view wx:else class="upload-placeholder">
          <text class="upload-icon">🖼️</text>
          <text class="body-text">添加你这餐的照片</text>
        </view>
      </view>
      <button class="secondary-pill" bindtap="chooseImage">从相册选择</button>
    </view>

    <view class="soft-card">
      <text class="section-title">语音补充</text>
      <textarea
        class="note-area"
        placeholder="例如：牛肉约100g，米饭半碗，零度可乐"
        placeholder-class="note-placeholder"
        value="{{voiceNote}}"
        maxlength="200"
        bindinput="handleVoiceInput"
      />
      <scroll-view class="tag-scroll" scroll-x="true" enable-flex="true">
        <view class="tag-row">
          <view wx:for="{{quickTags}}" wx:key="*this" class="pill tag-pill" data-tag="{{item}}" bindtap="applyTag">
            #{{item}}
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="soft-card">
      <button class="primary-button {{(!voiceNote || isLoading) ? 'disabled' : ''}}" disabled="{{!voiceNote || isLoading}}" bindtap="analyzeMeal">
        {{isLoading ? '识别中...' : 'AI 解析并记录'}}
      </button>
      <text wx:if="{{progressText}}" class="body-text status-text">{{progressText}}</text>
      <text wx:if="{{errorText}}" class="error-text">{{errorText}}</text>

      <view wx:if="{{lastAnalysis}}" class="analysis-card">
        <text class="analysis-title">{{lastAnalysis.guessedName}}</text>
        <text class="mono-text">{{lastAnalysis.nutrition.calories}} kcal · P{{lastAnalysis.nutrition.protein}} C{{lastAnalysis.nutrition.carbs}} F{{lastAnalysis.nutrition.fat}}</text>
        <text class="body-text">{{lastAnalysis.suggestion}}</text>
      </view>
    </view>

    <view class="soft-card">
      <text class="section-title">今日记录</text>
      
      <!-- 三餐记录框 -->
      <view class="meal-sections">
        <view class="meal-section">
          <text class="meal-title">🍳 早餐</text>
          <view wx:for="{{breakfastLogs}}" wx:key="id" class="meal-item">
            <view class="meal-item-header">
              <text class="meal-name">{{item.name}}</text>
              <text class="meal-tag">{{item.scoreTitle}}</text>
            </view>
            <text class="meal-nutrition">P{{item.nutrition.protein}} C{{item.nutrition.carbs}} F{{item.nutrition.fat}}</text>
            <text class="meal-calories">{{item.nutrition.calories}} kcal</text>
          </view>
          <text wx:if="{{!breakfastLogs.length}}" class="meal-empty">暂无记录</text>
        </view>
        
        <view class="meal-section">
          <text class="meal-title">🍽️ 午餐</text>
          <view wx:for="{{lunchLogs}}" wx:key="id" class="meal-item">
            <view class="meal-item-header">
              <text class="meal-name">{{item.name}}</text>
              <text class="meal-tag">{{item.scoreTitle}}</text>
            </view>
            <text class="meal-nutrition">P{{item.nutrition.protein}} C{{item.nutrition.carbs}} F{{item.nutrition.fat}}</text>
            <text class="meal-calories">{{item.nutrition.calories}} kcal</text>
          </view>
          <text wx:if="{{!lunchLogs.length}}" class="meal-empty">暂无记录</text>
        </view>
        
        <view class="meal-section">
          <text class="meal-title">🍲 晚餐</text>
          <view wx:for="{{dinnerLogs}}" wx:key="id" class="meal-item">
            <view class="meal-item-header">
              <text class="meal-name">{{item.name}}</text>
              <text class="meal-tag">{{item.scoreTitle}}</text>
            </view>
            <text class="meal-nutrition">P{{item.nutrition.protein}} C{{item.nutrition.carbs}} F{{item.nutrition.fat}}</text>
            <text class="meal-calories">{{item.nutrition.calories}} kcal</text>
          </view>
          <text wx:if="{{!dinnerLogs.length}}" class="meal-empty">暂无记录</text>
        </view>
      </view>
      
      <!-- 历史记录 -->
      <view wx:for="{{mealLogs}}" wx:key="id" class="history-item">
        <view>
          <text class="history-name">{{item.name}}</text>
          <text class="body-text">{{item.scoreTitle}}</text>
        </view>
        <text class="mono-text">{{item.nutrition.calories}} kcal</text>
      </view>
    </view>
  </view>
</scroll-view>

<!-- 选择餐次弹窗 -->
<page-container 
  show="{{showMealTypeDialog}}" 
  position="bottom" 
  bind:afterleave="onDialogClose"
  custom-style="height: 50vh; border-radius: 32rpx 32rpx 0 0;"
>
  <view class="meal-dialog">
    <view class="dialog-header">
      <text class="dialog-title">选择餐次</text>
      <view class="dialog-close" bindtap="hideMealTypeDialog">✕</view>
    </view>
    
    <view class="meal-options">
      <view class="meal-option" data-type="breakfast" bindtap="selectMealType">
        <text class="meal-option-emoji">🍳</text>
        <text class="meal-option-title">早餐</text>
        <text class="meal-option-desc">早上吃的食物</text>
      </view>
      
      <view class="meal-option" data-type="lunch" bindtap="selectMealType">
        <text class="meal-option-emoji">🍽️</text>
        <text class="meal-option-title">午餐</text>
        <text class="meal-option-desc">中午吃的食物</text>
      </view>
      
      <view class="meal-option" data-type="dinner" bindtap="selectMealType">
        <text class="meal-option-emoji">🍲</text>
        <text class="meal-option-title">晚餐</text>
        <text class="meal-option-desc">晚上吃的食物</text>
      </view>
    </view>
  </view>
</page-container>