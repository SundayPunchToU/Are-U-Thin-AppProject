.dashboard-scroll {
  height: 100vh;
}

.dashboard-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dashboard-badge {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  box-shadow: 0 20rpx 36rpx rgba(250, 114, 93, 0.24);
}

.dashboard-badge-text {
  font-size: 44rpx;
}

.story-strip {
  width: 100%;
  white-space: nowrap;
}

.story-row {
  display: inline-flex;
  padding-right: 20rpx;
}

.story-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
}

.story-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 124rpx;
  height: 124rpx;
  border-radius: 62rpx;
  background: linear-gradient(135deg, #fc8a68 0%, #ffb46f 100%);
}

.story-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: rgba(255, 255, 255, 0.84);
}

.story-emoji {
  font-size: 42rpx;
}

.story-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #747884;
}

.goal-calorie {
  display: block;
  margin-top: 18rpx;
  margin-bottom: 18rpx;
  font-size: 50rpx;
  color: #28282e;
}

.goal-progress {
  margin-bottom: 20rpx;
}

.macro-item {
  margin-top: 24rpx;
}

.macro-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.macro-title {
  font-size: 28rpx;
  color: #28282e;
}

.feed-section {
  display: flex;
  flex-direction: column;
}

.feed-section > text,
.feed-section > view {
  margin-top: 18rpx;
}

.feed-section > text:first-child,
.feed-section > view:first-child {
  margin-top: 0;
}

.feed-title {
  padding-left: 4rpx;
}

.feed-card {
  padding: 22rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 18rpx 40rpx rgba(26, 26, 26, 0.08);
}

.feed-cover {
  position: relative;
  height: 328rpx;
  border-radius: 30rpx;
  margin-bottom: 18rpx;
}

.feed-badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.16);
  color: #ffffff;
  font-size: 22rpx;
}

.feed-card-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #28282e;
}
