.dashboard-scroll {
  height: 100vh;
}

.dashboard-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.dashboard-header .header-copy {
  padding-top: 4rpx;
  padding-right: 20rpx;
}

.dashboard-badge {
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  margin-top: 6rpx;
  border-radius: 52rpx;
  box-shadow: 0 20rpx 36rpx rgba(250, 114, 93, 0.24);
}

.dashboard-badge-text {
  font-size: 44rpx;
}

.dashboard-card {
  display: flex;
  flex-direction: column;
}

.hero-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 247, 243, 0.92) 100%);
}

.dashboard-meta {
  display: block;
  margin-top: 10rpx;
}

.goal-calorie {
  display: block;
  margin-top: 18rpx;
  margin-bottom: 18rpx;
  font-size: 50rpx;
  color: #28282e;
}

.goal-progress {
  margin-bottom: 20rpx;
}

.dashboard-tip {
  margin-top: 12rpx;
}

.meal-status-wrap {
  margin-top: 18rpx;
}

.meal-status-title {
  display: block;
}

.meal-status-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.meal-status-chip {
  margin-right: 14rpx;
  margin-bottom: 14rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  color: #8b909b;
}

.meal-status-chip-active {
  background: rgba(250, 114, 93, 0.14);
  color: #fa725d;
  font-weight: 600;
}

.pill-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  margin-top: 20rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: #fa725d;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.macro-item {
  margin-top: 24rpx;
}

.macro-item:first-of-type {
  margin-top: 18rpx;
}

.macro-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.macro-title {
  font-size: 28rpx;
  color: #28282e;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meal-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 22rpx;
}

.meal-copy {
  flex: 1;
  padding-right: 20rpx;
}

.meal-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.meal-name {
  display: block;
  margin-bottom: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #28282e;
}

.meal-note {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #9aa0ab;
}

.meal-type-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(105, 184, 163, 0.14);
  font-size: 22rpx;
  color: #4b8f7d;
}

.meal-calorie {
  margin-top: 4rpx;
}

.empty-copy {
  display: block;
  margin-top: 18rpx;
}
