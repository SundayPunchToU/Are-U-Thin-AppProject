/* ── Page Container ─────────────────── */

.dashboard-scroll {
  height: 100vh;
}

.dashboard-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.dashboard-header .header-copy {
  padding-top: 4rpx;
  padding-right: 20rpx;
}

/* ── Header Badge ───────────────────── */

.dashboard-badge {
  flex-shrink: 0;
  width: 100rpx;
  height: 100rpx;
  margin-top: 8rpx;
  border-radius: 50rpx;
  box-shadow: 0 18rpx 34rpx rgba(250, 114, 93, 0.22);
}

.dashboard-badge-text {
  font-size: 42rpx;
}

/* ── Card Layout ────────────────────── */

.dashboard-card {
  display: flex;
  flex-direction: column;
}

.hero-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(255, 247, 243, 0.96) 100%);
}

.card-head {
  display: flex;
  flex-direction: column;
}

.card-caption {
  margin-top: 8rpx;
}

/* ── Goal Section ───────────────────── */

.goal-calorie {
  display: block;
  margin-top: 18rpx;
  margin-bottom: 16rpx;
  font-size: 46rpx;
  color: #25262c;
}

.goal-progress {
  margin-bottom: 18rpx;
}

.dashboard-highlight {
  color: #4f5561;
}

.dashboard-tip {
  margin-top: 12rpx;
}

/* ── Action Button ──────────────────── */

.pill-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  margin-top: 20rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: #fa725d;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(250, 114, 93, 0.16);
}

/* ── Macronutrient Card ─────────────── */

.macro-item {
  margin-top: 24rpx;
}

.macro-item:first-of-type {
  margin-top: 20rpx;
}

.macro-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.macro-title {
  font-size: 28rpx;
  color: #25262c;
}

/* ── Today Meals Card ──────────────── */

.meal-total-badge {
  font-size: 22rpx;
  color: #98a0ad;
}

.meal-type-block {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(242, 244, 247, 0.48);
}

.meal-type-block:first-of-type {
  margin-top: 16rpx;
}

.meal-type-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.meal-type-icon {
  font-size: 28rpx;
  line-height: 1;
}

.meal-type-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #515864;
}

/* ── Food Item ─────────────────────── */

.food-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ── Swipe-to-Delete ───────────────── */

.swipe-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
}

.swipe-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fa725d;
  border-radius: 0 16rpx 16rpx 0;
}

.swipe-delete-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.swipe-body {
  position: relative;
  z-index: 1;
  background: #ffffff;
  transition: transform 0.25s ease-out;
  will-change: transform;
}

.swipe-body.swipe-dragging {
  transition: none !important;
}

.food-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx;
  border-radius: 16rpx;
  background: transparent;
}

.food-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.food-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #25262c;
}

.food-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.food-tag {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(105, 184, 163, 0.12);
  font-size: 20rpx;
  color: #4b8f7d;
}

.food-tag:nth-child(2n) {
  background: rgba(250, 188, 111, 0.12);
  color: #c28a3e;
}

.food-macro {
  font-size: 20rpx;
  color: #98a0ad;
}

.food-calorie {
  flex-shrink: 0;
  margin-left: 16rpx;
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #515864;
}

.food-empty {
  display: block;
  padding: 12rpx 0 4rpx;
  font-size: 24rpx;
  color: #bcc1ca;
}

/* ── List Header (shared) ──────────── */

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ── Meal Type Picker Sheet ────────── */

.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.picker-sheet {
  width: 100%;
  padding: 0 36rpx 60rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.08);
  animation: micro-sheet-up 0.28s ease-out;
}

.picker-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 20rpx auto 0;
  border-radius: 4rpx;
  background: rgba(129, 135, 147, 0.2);
}

.picker-title {
  display: block;
  margin-top: 28rpx;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #25262c;
}

.picker-food-preview {
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: rgba(242, 244, 247, 0.6);
}

.picker-preview-text {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #737988;
}

.picker-preview-item {
  display: inline;
  font-size: 26rpx;
  font-weight: 500;
  color: #25262c;
}

.picker-preview-item + .picker-preview-item::before {
  content: "、";
  color: #bcc1ca;
}

.picker-options {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.picker-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 12rpx;
  border-radius: 20rpx;
  background: rgba(242, 244, 247, 0.6);
  transition: background 0.15s;
}

.picker-option:active {
  background: rgba(250, 114, 93, 0.10);
}

.picker-option-icon {
  font-size: 40rpx;
}

.picker-option-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #25262c;
}

.picker-cancel {
  display: flex;
  justify-content: center;
}

.picker-cancel-text {
  padding: 18rpx 64rpx;
  border-radius: 999rpx;
  background: rgba(242, 244, 247, 0.7);
  font-size: 28rpx;
  font-weight: 600;
  color: #515864;
}

/* ── Micro-nutrient Indicator Row ─────── */

.micro-indicator-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(242, 244, 247, 0.5);
}

.micro-dot-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.micro-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.micro-dot-good {
  background: #69b8a3;
}

.micro-dot-warn {
  background: #f5b86f;
}

.micro-dot-bad {
  background: #fa725d;
}

.micro-dot-label {
  font-size: 22rpx;
  color: #737988;
}

.micro-arrow {
  margin-left: auto;
  font-size: 32rpx;
  color: #bcc1ca;
  line-height: 1;
}

/* ── Micro-nutrient Bottom Sheet ──────── */

.micro-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.micro-sheet {
  width: 100%;
  max-height: 70vh;
  padding: 0 36rpx 60rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.08);
  overflow-y: auto;
  animation: micro-sheet-up 0.28s ease-out;
}

@keyframes micro-sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.micro-sheet-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 20rpx auto 0;
  border-radius: 4rpx;
  background: rgba(129, 135, 147, 0.2);
}

.micro-sheet-title {
  display: block;
  margin-top: 28rpx;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #25262c;
}

.micro-detail-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.micro-detail-item {
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(242, 244, 247, 0.6);
}

.micro-detail-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.micro-detail-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #25262c;
}

.micro-detail-status {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 600;
}

.micro-detail-status-good {
  color: #69b8a3;
}

.micro-detail-status-warn {
  color: #e5a44e;
}

.micro-detail-status-bad {
  color: #fa725d;
}

.micro-detail-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #737988;
}

.micro-sheet-close {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}

.micro-sheet-close-text {
  padding: 18rpx 64rpx;
  border-radius: 999rpx;
  background: rgba(242, 244, 247, 0.7);
  font-size: 28rpx;
  font-weight: 600;
  color: #515864;
}

/* ── Water Intake ────────────────────── */

.water-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.water-goal {
  font-size: 22rpx;
  color: #98a0ad;
}

.water-body {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  margin-bottom: 24rpx;
}

.water-cup-wrap {
  width: 110rpx;
  height: 160rpx;
  flex-shrink: 0;
  margin-right: 32rpx;
  position: relative;
}

.water-cup-body {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  border: 3rpx solid #d4dce6;
  border-top: none;
  border-radius: 0 0 24rpx 24rpx;
  overflow: hidden;
  background: #f2f4f7;
}

.water-cup-wrap::before {
  content: "";
  position: absolute;
  top: 0;
  left: -6rpx;
  right: -6rpx;
  height: 18rpx;
  border-radius: 10rpx 10rpx 0 0;
  background: #d4dce6;
}

.water-fill {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #a8d8ea;
  border-radius: 0 0 21rpx 21rpx;
  transition: height 0.4s ease;
}

.water-data {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.water-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #25262c;
}

.water-tip {
  font-size: 24rpx;
  color: #737988;
  margin-top: 6rpx;
  margin-bottom: 12rpx;
}

.water-bar-bg {
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
  background: #eef0f3;
}

.water-bar-fg {
  height: 100%;
  border-radius: 4rpx;
  background: #7ec8e3;
  transition: width 0.4s ease;
}

.water-btn-wrap {
  display: flex;
  justify-content: center;
}

.water-btn {
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: #7ec8e3;
}

.water-btn-active {
  opacity: 0.7;
}

.water-btn-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}
