.dashboard-scroll {
  height: 100vh;
}

.dashboard-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.dashboard-header .header-copy {
  padding-top: 4rpx;
  padding-right: 20rpx;
}

.dashboard-badge {
  flex-shrink: 0;
  width: 100rpx;
  height: 100rpx;
  margin-top: 8rpx;
  border-radius: 50rpx;
  box-shadow: 0 18rpx 34rpx rgba(250, 114, 93, 0.22);
}

.dashboard-badge-text {
  font-size: 42rpx;
}

.dashboard-card {
  display: flex;
  flex-direction: column;
}

.hero-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(255, 247, 243, 0.96) 100%);
}

.card-head {
  display: flex;
  flex-direction: column;
}

.card-caption {
  margin-top: 8rpx;
}

.goal-calorie {
  display: block;
  margin-top: 18rpx;
  margin-bottom: 16rpx;
  font-size: 46rpx;
  color: #25262c;
}

.goal-progress {
  margin-bottom: 18rpx;
}

.dashboard-highlight {
  color: #4f5561;
}

.dashboard-tip {
  margin-top: 12rpx;
}

.meal-status-wrap {
  margin-top: 20rpx;
  padding: 18rpx 18rpx 4rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.56);
}

.meal-status-title {
  display: block;
}

.meal-status-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.meal-status-chip {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  color: #8a909b;
}

.meal-status-chip-active {
  background: rgba(250, 114, 93, 0.14);
  color: #fa725d;
  font-weight: 600;
}

.pill-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  margin-top: 20rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: #fa725d;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(250, 114, 93, 0.16);
}

.macro-item {
  margin-top: 24rpx;
}

.macro-item:first-of-type {
  margin-top: 20rpx;
}

.macro-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.macro-title {
  font-size: 28rpx;
  color: #25262c;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meal-list {
  margin-top: 8rpx;
}

.meal-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 20rpx 0 0;
  border-top: 1rpx solid rgba(129, 135, 147, 0.12);
}

.meal-item:first-child {
  border-top: none;
}

.meal-copy {
  flex: 1;
  padding-right: 20rpx;
}

.meal-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.meal-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #25262c;
}

.meal-score {
  color: #666c78;
}

.meal-note {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.58;
  color: #98a0ad;
}

.meal-type-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(105, 184, 163, 0.14);
  font-size: 22rpx;
  color: #4b8f7d;
}

.meal-calorie {
  margin-top: 2rpx;
}

.empty-copy {
  display: block;
  margin-top: 18rpx;
}
