<view class="screen-tight onboarding-screen" style="padding-top: {{pageTopInset}}px;">
  <view class="onboarding-head header-copy onboarding-header-copy">
    <text class="hero-title">瘦了吗</text>
    <text class="hero-subtitle">先选一个健康目标，我们会用更温和的方式陪你记录每一餐。</text>
  </view>

  <view class="soft-card onboarding-card">
    <view class="section-head">
      <text class="section-title">1. 你的目标</text>
    </view>
    <view class="goal-list">
      <view
        wx:for="{{goalOptions}}"
        wx:key="value"
        class="goal-option {{goal === item.value ? 'goal-option-active' : ''}}"
        data-goal="{{item.value}}"
        bindtap="chooseGoal"
      >
        <text class="goal-emoji">{{item.emoji}}</text>
        <view class="goal-copy">
          <text class="goal-name {{goal === item.value ? 'goal-name-active' : ''}}">{{item.label}}</text>
          <text class="goal-subcopy {{goal === item.value ? 'goal-subcopy-active' : ''}}">{{item.supportiveSubtitle}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="soft-card onboarding-card">
    <view class="section-head">
      <text class="section-title">2. 你的基础信息</text>
    </view>

    <view class="metric-block">
      <view class="metric-header">
        <text class="metric-label">年龄</text>
        <text class="metric-value">{{age}} 岁</text>
      </view>
      <slider min="16" max="80" step="1" value="{{age}}" activeColor="#FA725D" backgroundColor="#E9EBEF" bindchange="handleAgeChange" />
    </view>

    <view class="metric-block">
      <view class="metric-header">
        <text class="metric-label">身高</text>
        <text class="metric-value">{{heightCm}} cm</text>
      </view>
      <slider min="140" max="200" step="1" value="{{heightCm}}" activeColor="#69B8A3" backgroundColor="#E9EBEF" bindchange="handleHeightChange" />
    </view>

    <view class="metric-block">
      <view class="metric-header">
        <text class="metric-label">体重</text>
        <text class="metric-value">{{weightKg}} kg</text>
      </view>
      <slider min="35" max="120" step="1" value="{{weightKg}}" activeColor="#FABC5F" backgroundColor="#E9EBEF" bindchange="handleWeightChange" />
    </view>

    <view class="metric-block metric-block-last">
      <view class="metric-header">
        <text class="metric-label">日常活动</text>
        <text class="metric-value">{{activityText}}</text>
      </view>
      <slider min="12" max="19" step="1" value="{{activityValue}}" activeColor="#69B8A3" backgroundColor="#E9EBEF" bindchange="handleActivityChange" />
    </view>
  </view>

  <view class="soft-card preview-card">
    <view class="section-head preview-head">
      <text class="section-title">3. 今日建议</text>
    </view>
    <text class="preview-calorie">≈ {{calorieTarget}} kcal / 天</text>
    <text class="body-text preview-body">蛋白 {{macroTargets.proteinTarget}}g · 碳水 {{macroTargets.carbTarget}}g · 脂肪 {{macroTargets.fatTarget}}g</text>
    <text class="body-text preview-message">{{goalTitle}}，从第一餐开始慢慢建立节奏就很好。</text>
    <text class="helper-text preview-footnote">{{goalSubtitle}}</text>
  </view>

  <button class="primary-button {{isSubmitting ? 'disabled' : ''}}" disabled="{{isSubmitting}}" bindtap="submitProfile">{{isSubmitting ? '保存中...' : '开始记录今天'}}</button>
  <text wx:if="{{errorText}}" class="error-text">{{errorText}}</text>
</view>
