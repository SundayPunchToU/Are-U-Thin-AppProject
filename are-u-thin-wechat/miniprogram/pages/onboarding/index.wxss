.onboarding-screen {
  display: flex;
  flex-direction: column;
}

.onboarding-screen > view,
.onboarding-screen > button {
  margin-top: 24rpx;
}

.onboarding-screen > view:first-child,
.onboarding-screen > button:first-child {
  margin-top: 0;
}

.onboarding-head {
  margin-top: 8rpx;
}

.onboarding-header-copy {
  max-width: 92%;
}

.onboarding-header-copy .hero-subtitle {
  max-width: 100%;
}

.onboarding-card,
.preview-card {
  display: flex;
  flex-direction: column;
}

.goal-list {
  margin-top: 24rpx;
}

.goal-option {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-top: 16rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
}

.goal-option:first-child {
  margin-top: 0;
}

.goal-option-active {
  background: #fa725d;
}

.goal-emoji {
  font-size: 42rpx;
}

.goal-copy {
  flex: 1;
  margin-left: 18rpx;
}

.goal-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #28282e;
}

.goal-name-active,
.goal-subcopy-active {
  color: #ffffff;
}

.goal-subcopy {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #747884;
}

.metric-block {
  margin-top: 24rpx;
}

.metric-block-last {
  margin-bottom: 4rpx;
}

.metric-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.metric-label {
  font-size: 30rpx;
  color: #28282e;
}

.metric-value {
  font-size: 28rpx;
  color: #747884;
  font-family: "Menlo", "SFMono-Regular", monospace;
}

.preview-calorie {
  margin-top: 18rpx;
  font-size: 52rpx;
  line-height: 1.2;
  color: #28282e;
  font-family: "Menlo", "SFMono-Regular", monospace;
}

.preview-body {
  margin-top: 10rpx;
}

.preview-footnote {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #747884;
}
