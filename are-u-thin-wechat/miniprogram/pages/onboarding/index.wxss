.onboarding-screen {
  display: flex;
  flex-direction: column;
}

.onboarding-screen > view,
.onboarding-screen > button {
  margin-top: 26rpx;
}

.onboarding-screen > view:first-child,
.onboarding-screen > button:first-child {
  margin-top: 0;
}

.onboarding-head {
  margin-top: 6rpx;
}

.onboarding-header-copy {
  max-width: 90%;
}

.onboarding-header-copy .hero-subtitle {
  max-width: 100%;
}

.onboarding-card,
.preview-card {
  display: flex;
  flex-direction: column;
}

.section-head {
  display: flex;
  flex-direction: column;
}

.section-hint {
  margin-top: 8rpx;
}

.goal-list {
  margin-top: 24rpx;
}

.goal-option {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 22rpx;
  margin-top: 14rpx;
  border-radius: 28rpx;
  background: rgba(249, 250, 252, 0.92);
  border: 1rpx solid rgba(240, 223, 217, 0.55);
}

.goal-option:first-child {
  margin-top: 0;
}

.goal-option-active {
  background: linear-gradient(135deg, #fa725d 0%, #ff947d 100%);
  box-shadow: 0 16rpx 30rpx rgba(250, 114, 93, 0.18);
}

.goal-emoji {
  font-size: 42rpx;
  line-height: 1.1;
}

.goal-copy {
  flex: 1;
  margin-left: 18rpx;
}

.goal-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #25262c;
}

.goal-name-active,
.goal-subcopy-active {
  color: #ffffff;
}

.goal-subcopy {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.58;
  color: #6f7480;
}

.metric-block {
  margin-top: 24rpx;
  padding: 20rpx 20rpx 10rpx;
  border-radius: 28rpx;
  background: rgba(248, 249, 251, 0.75);
}

.metric-block-last {
  margin-bottom: 4rpx;
}

.metric-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.metric-label {
  font-size: 29rpx;
  color: #25262c;
}

.metric-value {
  font-size: 26rpx;
  color: #6f7480;
  font-family: "Menlo", "SFMono-Regular", monospace;
}

.preview-head {
  margin-bottom: 4rpx;
}

.preview-calorie {
  margin-top: 18rpx;
  font-size: 48rpx;
  line-height: 1.2;
  color: #25262c;
  font-family: "Menlo", "SFMono-Regular", monospace;
}

.preview-body {
  margin-top: 10rpx;
}

.preview-message {
  margin-top: 8rpx;
}

.preview-footnote {
  margin-top: 12rpx;
}
