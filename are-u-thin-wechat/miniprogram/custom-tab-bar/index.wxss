.tab-shell {
  position: fixed;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
  z-index: 999;
  pointer-events: none;
}

.tab-bar {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  padding: 12rpx 12rpx 28rpx;
  border-radius: 40rpx;
  background: rgba(253, 248, 242, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 36rpx rgba(25, 25, 25, 0.1);
  pointer-events: auto;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
}

.tab-item-active {
  position: relative;
}

.tab-icon {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1;
}

.tab-text {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1;
}

/* ── Center + Button ─────────────────── */

.tab-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
}

.tab-center-btn {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #fa725d 0%, #f5956b 100%);
  box-shadow: 0 8rpx 24rpx rgba(250, 114, 93, 0.40);
  transition: transform 0.15s, box-shadow 0.15s;
}

.tab-center-btn:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(250, 114, 93, 0.30);
}

.tab-center-icon {
  font-size: 48rpx;
  font-weight: 300;
  color: #ffffff;
  line-height: 1;
  margin-top: -4rpx;
}
